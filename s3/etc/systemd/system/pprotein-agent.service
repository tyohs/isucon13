# isutools 管理ファイル（手で編集しない）
[Unit]
Description=pprotein-agent (isutools)
After=network.target

[Service]
User=isucon
SupplementaryGroups=adm mysql
Environment=PORT=19000
Environment=PPROTEIN_HTTPLOG=/var/log/nginx/access.log
Environment=PPROTEIN_SLOWLOG=/var/log/mysql/mysql-slow.log
Environment=PPROTEIN_GIT_REPOSITORY=/home/isucon
ExecStart=/usr/local/bin/pprotein-agent
Restart=always

[Install]
WantedBy=multi-user.target
